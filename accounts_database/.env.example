# PostgreSQL connection (choose either DATABASE_URL or individual PG* variables)
# DATABASE_URL format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Or specify individually (these are ignored when DATABASE_URL is provided)
PGHOST=localhost
PGPORT=5432
PGDATABASE=accounts_db
PGUSER=postgres
PGPASSWORD=

# IMPORTANT for multi-tenancy & RLS:
# Your application must set the current tenant AT THE DB SESSION LEVEL per request/connection via:
#   SET app.current_tenant = '<tenant-uuid>';
# or in code (Knex/pg):
#   await knex.raw(\"SELECT set_config('app.current_tenant', ?, true)\", [tenantUuid]);
